{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "AE2 Emi Integration",
  "description": "Unofficial Integration between AE2 and EMI for versions without official support",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/template/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "org.blocovermelho.ae2emi.platform.fabric.Ae2EmiModClient"
    ],
    "main": [
      "org.blocovermelho.ae2emi.platform.fabric.Ae2EmiMod"
    ],
    "emi": [
      "org.blocovermelho.ae2emi.platform.facade.Ae2EmiPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "emi": ">=${emi_version}",
    "ae2": ">=${ae2_version}"
  },
  "recommends": {
    "mcqoy": "*"
  }
}
